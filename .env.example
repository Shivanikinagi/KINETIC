# ============================================
# KINETIC MARKETPLACE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# Never commit real keys to git!

# ============================================
# ALGORAND CONFIGURATION
# ============================================

# Network: testnet or mainnet
ALGORAND_NETWORK=testnet

# Algorand Node URL (use AlgoNode for free access)
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# Algorand Indexer URL
INDEXER_URL=https://testnet-idx.algonode.cloud

# ============================================
# SMART CONTRACT APP IDs (TestNet)
# ============================================

# Provider Registry Contract
# View: https://testnet.algoexplorer.io/application/758813563
REGISTRY_APP_ID=758813563

# Escrow Contract
# View: https://testnet.algoexplorer.io/application/758813574
ESCROW_APP_ID=758813574

# Badge Minter Contract
# View: https://testnet.algoexplorer.io/application/758813562
BADGE_APP_ID=758813562

# Organization Registry (optional)
ORG_REGISTRY_APP_ID=

# ============================================
# WALLET MNEMONICS (25-word phrases)
# ============================================
# Generate: python -c "from algosdk.account import generate_account; print(generate_account()[0])"
# Fund: https://bank.testnet.algorand.network/

# Consumer Agent Wallet (for submitting jobs)
AGENT_MNEMONIC=word1 word2 word3 ... word25

# Provider Wallet (for receiving payments)
PROVIDER_MNEMONIC=word1 word2 word3 ... word25

# Admin Wallet (for contract deployment)
ADMIN_MNEMONIC=word1 word2 word3 ... word25

# ============================================
# PROVIDER CONFIGURATION
# ============================================

# Provider wallet address (derived from PROVIDER_MNEMONIC)
PROVIDER_WALLET=

# Provider endpoint URL (where your provider API is hosted)
PROVIDER_ENDPOINT=https://your-provider-domain.example

# Hardware specifications
PROVIDER_VRAM_GB=8
PROVIDER_GPU_MODEL=RTX3090

# ============================================
# AGENT BUDGET LIMITS
# ============================================

# Maximum spend per job (in microALGO)
# 500,000 microALGO = 0.5 ALGO
AGENT_BUDGET_PER_JOB_MICROALGO=500000

# Maximum daily spend (in microALGO)
# 5,000,000 microALGO = 5 ALGO
AGENT_DAILY_BUDGET_MICROALGO=5000000

# ============================================
# PRICING
# ============================================

# Price per token (in microALGO)
# 100 microALGO = 0.0001 ALGO per token
JOB_PRICE_PER_TOKEN_MICROALGO=100

# ============================================
# EXECUTION MODE
# ============================================

# Set to "real" for Docker/subprocess execution
# Set to "simulated" for asyncio.sleep (testing only)
EXECUTION_MODE=real

# ============================================
# DATABASE (Optional - SQLite used by default)
# ============================================

# PostgreSQL connection string (optional)
# Example: postgresql+asyncpg://user:pass@localhost:5432/kinetic
DATABASE_URL=

# ============================================
# REDIS (Optional - for rate limiting)
# ============================================

# Redis connection string (optional)
# Example: redis://localhost:6379/0
REDIS_URL=

# ============================================
# AUTHENTICATION (Optional)
# ============================================

# JWT secret key (generate: openssl rand -hex 32)
JWT_SECRET=

# JWT issuer
JWT_ISSUER=kinetic

# JWT access token TTL (minutes)
JWT_ACCESS_TTL_MINUTES=60

# Auth nonce TTL (seconds)
AUTH_NONCE_TTL_SECONDS=300

# ============================================
# RATE LIMITING (Optional)
# ============================================

# API key rate limit (requests per minute)
API_KEY_RATE_LIMIT_RPM=120

# ============================================
# OBSERVABILITY (Optional)
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# ORGANIZATION REGISTRY (Optional)
# ============================================

# Funding amount for org registry (microALGO)
ORG_REGISTRY_APP_FUND_MICROALGO=500000

# ============================================
# NOTES
# ============================================
# 1. Never commit real mnemonics to git
# 2. Fund wallets at: https://bank.testnet.algorand.network/
# 3. View contracts at: https://testnet.algoexplorer.io/
# 4. Generate mnemonics: algosdk.account.generate_account()
# 5. 1 ALGO = 1,000,000 microALGO
